<div class="postPage">
    <a href="/c/<%= commUrlId %>" class="backLink">
        ← Wróć do <strong>c/<%= communityName %></strong>
    </a>

    <article class="postContainer">
        <header class="postMeta">
            <span class="communityName">c/<%= communityName %></span>
            <span class="separator">•</span>
            <span class="postAuthor">u/<%= post.author %></span>
            <span class="separator">•</span>
            <span class="postDate"><%= new Date(post.createdAt).toLocaleString("pl-PL") %></span>
        </header>

        <h1 class="postTitle">
            <%= post.title %>
            <% if (post.isSpoiler) { %>
                <span class="spoilerBadge">[SPOILER]</span>
            <% } %>
            
            <% if (user && post.authorId.toString() === user.id) { %>
                <div class="authorActions">
                    <a href="/c/<%= commUrlId %>/post/<%= post.urlId %>/edit" class="editLink">[EDYTUJ]</a>
                    <form
                        method="POST"
                        action="/c/<%= commUrlId %>/post/<%= post.urlId %>/delete"
                        onsubmit="return confirm('Czy na pewno chcesz usunąć ten post?')"
                        class="inlineForm"
                    >
                        <button type="submit" class="deleteBtn">
                            [Usuń post]
                        </button>
                    </form>
                </div>
            <% } %>
        </h1>

        <div class="postContent <%= post.isSpoiler ? 'spoiler' : '' %>" id="postContent">
            <%= post.content %>
        </div>

        <div class="postActions">
            <form method="POST" action="/c/<%= commUrlId %>/post/<%= post.urlId %>/like" class="likeForm">
                <button type="submit" class="likeBtn <%= isLiked ? 'isLiked' : '' %>">
                    <span class="heartIcon"><%= isLiked ? '❤️' : '🤍' %></span>
                    <span class="likesCount">Likes: <%= post.likesCount %></span>
                </button>
            </form>

            <% if (post.tags && post.tags.length > 0) { %>
                <div class="postTags">
                    <% post.tags.forEach(tag => { %>
                        <span class="tagItem">#<%= tag %></span>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </article>
</div>

<script>
    const spoiler = document.getElementById("postContent");
    if (spoiler && spoiler.classList.contains("spoiler")) {
        spoiler.addEventListener("click", () => {
            spoiler.classList.toggle("revealed");
        });
    }
</script>