<% if (!posts || posts.length === 0) { %>
    <div class="feedEmpty">
        <p>Brak postów w tej społeczności 😕</p>
    </div>
<% } else { %>
    <div class="feedWrapper">
        <% posts.forEach(post => { %>
            <article class="feedCard">
                <div class="feedVoting">
                    <span class="voteArrow">▲</span>
                    <span class="voteCount"><%= post.likesCount %></span>
                </div>

                <div class="feedMain">
                    <header class="feedMeta">
                        <span class="feedUser">u/<%= post.author %></span>
                        <% if (post.createdAt) { %>
                            <span class="feedTime">• <%= new Date(post.createdAt).toLocaleDateString("pl-PL") %></span>
                        <% } %>
                    </header>

                    <h2 class="feedTitle">
                        <a href="/c/<%= commUrlId %>/post/<%= post.urlId %>"><%= post.title %></a>
                    </h2>

                    <div class="feedBody">
                        <% if (post.isSpoiler) { %>
                            <span class="badgeSpoiler">SPOILER</span>
                            <span class="textHidden">Kliknij, aby przeczytać treść...</span>
                        <% } else { %>
                            <p class="feedSnippet"><%= post.content %></p>
                        <% } %>
                    </div>

                    <footer class="feedFooter">
                        <% if (post.tags && post.tags.length > 0) { %>
                            <div class="feedTags">
                                <% post.tags.forEach(tag => { %>
                                    <span class="feedTag">#<%= tag %></span>
                                <% }) %>
                            </div>
                        <% } %>
                    </footer>
                </div>
            </article>
        <% }) %>
    </div>
<% } %>