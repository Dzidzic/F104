<h1 class="pageTitle">Odkrywaj społeczności</h1>

<% if (communities.length === 0) { %>
    <div class="exploreEmpty">
        <p>Brak społeczności do wyświetlenia. Może czas stworzyć własną?</p>
    </div>
<% } else { %>
    <div class="exploreWrapper">
        <% communities.forEach(community => { %>
            <div class="exploreCard">
                <div class="exploreContent">
                    <div class="exploreHeader">
                        <h2 class="exploreName">
                            <a href="/c/<%= community.urlId %>">
                                c/<%= community.name %>
                            </a>
                        </h2>
                    </div>

                    <p class="exploreDesc"><%= community.description %></p>

                    <% if (community.theme) { %>
                        <div class="exploreThemeBox">
                            <a href="/c?theme=<%= community.theme %>" class="exploreTag">
                                <%= community.theme %>
                            </a>
                        </div>
                    <% } %>
                </div>
                
                <div class="exploreAction">
                    <a href="/c/<%= community.urlId %>" class="exploreViewBtn">Zobacz</a>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>