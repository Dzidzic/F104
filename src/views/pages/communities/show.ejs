<div class="communityHeader">
    <div class="communityTitleBar">
        <h1 class="communityTitle">c/<%= communityInfo.name %></h1>
        
        <% if(user && user.id == communityInfo.creatorId) { %>        
            <div class="adminActions">
                <a href="<%= commUrlId %>/edit" class="editBtn">Edytuj</a> 
                <form
                    method="POST"
                    action="<%= commUrlId %>/delete"
                    onsubmit="return confirm('Czy na pewno chcesz usunąć tę społeczność? Tej operacji nie da się cofnąć!')"
                    class="deleteForm"
                >
                    <button type="submit" class="deleteBtn">Usuń społeczność</button>
                </form>
            </div>
        <% } %>
    </div>

    <p class="communityMeta">
        Stworzona przez: <strong><%= creatorName %></strong>
    </p>

    <p class="communityDescriptionText">
        <%= communityInfo.description %>
    </p>

    <div class="communityThemeWrapper">
        <a href="/c?theme=<%= communityInfo.theme %>" class="themeTag">
            <%= communityInfo.theme %>
        </a>
    </div>

    <% if(user) { %>
        <div class="actionArea">
            <a href="<%= commUrlId %>/post/add" class="addPostBtn">+ Dodaj post</a>
        </div>
    <% } %>
</div>

<section class="postsSection">
    <div class="postsHeader">
        <h2 class="sectionTitle">Lista postów</h2>

        <form method="GET" class="sortForm">
            <input
                type="text"
                name="tag"
                class="tagFilterInput"
                placeholder="Filtruj po tagu..."
                value="<%= tagFilter || '' %>"
            >
          
            <div class="sortControls">
                <label for="sortBy">Sortuj po:</label>
                <select name="sortBy" id="sortBy">
                    <option value="date" <%= sortBy === "date" ? "selected" : "" %>>Data dodania</option>
                    <option value="title" <%= sortBy === "title" ? "selected" : "" %>>Tytuł</option>
                    <option value="likes" <%= sortBy === "likes" ? "selected" : "" %>>Polubienia</option>
                </select>

                <select name="order">
                    <option value="desc" <%= order === -1 ? "selected" : "" %>>Malejąco</option>
                    <option value="asc" <%= order === 1 ? "selected" : "" %>>Rosnąco</option>
                </select>

                <button type="submit" class="sortSubmitBtn">Filtruj</button>
            </div>
        </form>
    </div>

    <div class="postsContainer">
        <%- include('../posts/list.ejs', { posts: posts }) %>
    </div>
</section>