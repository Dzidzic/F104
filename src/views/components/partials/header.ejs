<header class="mainHeader">
    <nav class="navLeft">
        <a href="/" class="logo">DitRed</a>
        <a href="/">Główna</a>
        <a href="/about">O projekcie</a>
        <% if (user) { %>
            <a href="/c/add">Dodaj społeczność</a>
        <% } %>
    </nav>

    <nav class="navRight">
        <% if (!user) { %>
            <a href="/auth/login" class="loginBtn">Zaloguj</a>
            <a href="/auth/register" class="registerBtn">Rejestracja</a>
        <% } else { %>
            <span class="welcomeMessage">
                Witaj <strong><%= user.username %></strong>!
            </span>
            <a href="/auth/logout" class="logoutLink">Wyloguj</a>
        <% } %>
    </nav>
</header>