<form method="POST" action="/auth/login" class="authForm">
    <div class="authGroup">
        <label for="login" class="authLabel">Nazwa użytkownika lub e-mail</label>
        <input
            type="text"
            id="login"
            name="login"
            placeholder="Twoja nazwa lub email"
            value="<%= validator.login !== 'invalid' ? validator.login : '' %>"
            class="authInput <%= validator.login === 'invalid' ? 'inputError' : '' %>"
            required
            autocomplete="username"
        >

        <% if (validator.login === 'invalid') { %>
            <small class="errorMsg">
                Nieprawidłowa nazwa użytkownika lub e-mail
            </small>
        <% } %>
    </div>

    <div class="authGroup">
        <label for="password" class="authLabel">Hasło</label>
        <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            class="authInput <%= validator.password === 'invalid' ? 'inputError' : '' %>"
            required
            autocomplete="current-password"
        >

        <% if (validator.password === 'invalid') { %>
            <small class="errorMsg">
                Nieprawidłowe hasło
            </small>
        <% } %>
    </div>

    <button type="submit" class="submitBtn">Zaloguj się</button>
    
    <div class="authFooter">
        Nie masz konta? <a href="/auth/register">Zarejestruj się</a>
    </div>
</form>