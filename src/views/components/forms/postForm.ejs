<form method="POST" action="<%= formAction %>" class="postForm">
    <div class="formGroup">
        <label for="title">Tytuł posta</label>
        <input
            type="text"
            id="title"
            name="title"
            placeholder="O czym chcesz napisać?"
            value="<%= validator.title !== 'invalid' && validator.title !== 'taken' ? validator.title : '' %>"
            class="<%= (validator.title === 'invalid' || validator.title === 'taken') ? 'inputError' : '' %>"
        >
        <% if (validator.title === 'invalid') { %>
            <small class="errorMsg">Tytuł musi mieć od 5 do 50 znaków</small>
        <% } %>
        <% if (validator.title === 'taken') { %>
            <small class="errorMsg">Podany tytuł jest już zajęty</small>
        <% } %>
    </div>

    <div class="formGroup">
        <label for="content">Treść posta</label>
        <textarea
            id="content"
            name="content"
            rows="8"
            placeholder="Tutaj wpisz treść swojego posta..."
            class="<%= validator.content === 'invalid' ? 'inputError' : '' %>"
        ><%= validator.content !== 'invalid' ? validator.content : '' %></textarea>
        <% if (validator.content === 'invalid') { %>
            <small class="errorMsg">Treść musi mieć pomiędzy 20 a 5000 znaków</small>
        <% } %>
    </div>

    <div class="formGroup">
        <label for="tags">Tagi (opcjonalnie)</label>
        <input
            type="text"
            id="tags"
            name="tags"
            placeholder="np. express, backend, javascript"
            value="<%= validator.tags !== 'invalid' ? validator.tags : '' %>"
            class="<%= validator.tags === 'invalid' ? 'inputError' : '' %>"
        >
        <% if (validator.tags === 'invalid') { %>
            <small class="errorMsg">Nieprawidłowe tagi</small>
        <% } %>
        <div class="formHint">Maks. 5 tagów, oddzielone przecinkami</div>
    </div>

    <div class="formGroup checkboxGroup">
        <label class="checkboxContainer">
            <input
                type="checkbox"
                name="spoiler"
                <%= validator.spoiler === true ? "checked" : "" %>
            >
            <span class="checkboxLabel">Ten post zawiera spoilery</span>
        </label>
    </div>

    <button type="submit" class="submitBtn">
        <% if (formAction.includes('/edit')) { %>Zapisz zmiany<% } else { %>Opublikuj post<% } %>
    </button>
</form>