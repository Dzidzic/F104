
<form method="POST" action="/auth/register" class="authForm">
    <div class="authGroup">
        <label for="username" class="authLabel">Nazwa użytkownika</label>
        <input
            type="text"
            id="username"
            name="username"
            placeholder="np. explorer_12"
            value="<%= validator.username !== 'invalid' && validator.username !== 'userExist' ? validator.username : '' %>"
            class="authInput <%= validator.username === 'invalid' || validator.username === 'userExist' ? 'inputError' : '' %>"
            required
            minlength="3"
            maxlength="20"
            autocomplete="username"
        >
        <% if (validator.username === 'invalid') { %>
            <small class="errorMsg">Nazwa użytkownika jest nieprawidłowa</small>
        <% } %>
        <% if (validator.username === 'userExist') { %>
            <small class="errorMsg">Ta nazwa użytkownika jest już zajęta</small>
        <% } %>
    </div>

    <div class="authGroup">
        <label for="email" class="authLabel">Adres e-mail</label>
        <input
            type="email"
            id="email"
            name="email"
            placeholder="twoj@email.pl"
            value="<%= validator.email !== 'invalid' && validator.email !== 'userExist' ? validator.email : '' %>"
            class="authInput <%= validator.email === 'invalid' || validator.email === 'userExist' ? 'inputError' : '' %>"
            required
            autocomplete="email"
        >
        <% if (validator.email === 'invalid') { %>
            <small class="errorMsg">Nieprawidłowy adres e-mail</small>
        <% } %>
        <% if (validator.email === 'userExist') { %>
            <small class="errorMsg">Ten adres e-mail jest już zarejestrowany</small>
        <% } %>
    </div>

    <div class="authGroup">
        <label for="password" class="authLabel">Hasło</label>
        <input
            type="password"
            id="password"
            name="password"
            placeholder="Wpisz bezpieczne hasło"
            class="authInput <%= validator.password === 'invalid' ? 'inputError' : '' %>"
            required
            minlength="8"
            autocomplete="new-password"
        >
        <% if (validator.password === 'invalid') { %>
            <small class="errorMsg">Hasło nie spełnia wymagań</small>
        <% } %>
    </div>

    <div class="authGroup">
        <label for="passwordConfirm" class="authLabel">Powtórz hasło</label>
        <input
            type="password"
            id="passwordConfirm"
            name="passwordConfirm"
            placeholder="Wpisz hasło ponownie"
            class="authInput <%= validator.passwordConfirm === 'invalid' ? 'inputError' : '' %>"
            required
            minlength="8"
            autocomplete="new-password"
        >
        <% if (validator.passwordConfirm === 'invalid') { %>
            <small class="errorMsg">Hasła muszą być identyczne</small>
        <% } %>
    </div>

    <button type="submit" class="submitBtn">Zarejestruj się</button>

    <div class="authPasswordRequirements">
        <p>Hasło musi zawierać:</p>
        <ul class="requirementsList">
            <li>Minimum 8 znaków</li>
            <li>Małą i dużą literę</li>
            <li>Cyfrę oraz znak specjalny (!@#$%^&*)</li>
        </ul>
    </div>

    <div class="authFooter">
        Masz już konto? <a href="/auth/login">Zaloguj się</a>
    </div>
</form>