
<form method="POST" action="<%= formAction %>" class="communityForm">
    <div class="formGroup">
        <label for="name">Nazwa społeczności</label>
        <input
            type="text"
            id="name"
            name="name"
            value="<%= validator.name !== 'invalid' ? (validator.name !== 'taken' ? validator.name : '') : '' %>"
            class="<%= (validator.name === 'invalid' || validator.name === 'taken') ? 'inputError' : '' %>"
            placeholder="np. Programowanie"
        >
        <% if (validator.name === 'invalid') { %>
            <small class="errorMsg">Błąd! Dopuszczalna nazwa: 3-50 znaków, bez spacji i znaków specjalnych</small>
        <% } else if (validator.name === 'taken') { %>
            <small class="errorMsg">Społeczność pod taką nazwą już istnieje</small>
        <% } %>
    </div>

    <div class="formGroup">
        <label for="description">Opis społeczności</label>
        <textarea
            id="description"
            name="description"
            rows="4"
            placeholder="O czym jest ta społeczność?"
            class="<%= validator?.description === 'invalid' ? 'inputError' : '' %>"
        ><%= validator.description !== 'invalid' ? validator.description : '' %></textarea>
        <% if (validator.description === 'invalid') { %>
            <small class="errorMsg">Opis musi zawierać od 10 do 500 znaków</small>
        <% } %>
    </div>

    <div class="formGroup">
        <label for="theme">Tematyka społeczności</label>
        <select id="theme" name="theme" class="<%= validator.theme === 'invalid' ? 'inputError' : '' %>">
            <% const themes = ["----------------", "Programowanie", "Gry", "Sport", "Kultura", "Inna"]; %>
            <% themes.forEach(theme => { %>
                <option 
                    value="<%= theme %>" 
                    <%= validator.theme === theme ? "selected" : "" %>
                >         
                    <%= theme %>
                </option>
            <% }) %>
        </select>
        <% if (validator.theme === 'invalid') { %>
            <small class="errorMsg">Wybierz tematykę społeczności</small>
        <% } %>

        <div id="customTheme" class="customThemeWrapper" style="display: <%= validator.theme === 'Inna' ? 'block' : 'none' %>;">
            <input
                type="text"
                name="customTheme"
                placeholder="Wpisz własną tematykę"
                value="<%= validator.customTheme !== 'invalid' ? validator.customTheme : '' %>"
                class="<%= validator.customTheme === 'invalid' ? 'inputError' : '' %>"
            >
            <% if (validator.customTheme === 'invalid') { %>
                <small class="errorMsg">Podaj własną tematykę</small>
            <% } %>
        </div>
    </div>

    <button type="submit" class="submitBtn">
        <%= formAction.includes("edit") ? "Zapisz zmiany" : "Utwórz społeczność" %>
    </button>
</form>

<script>
    const themeSelect = document.getElementById('theme');
    const customDiv = document.getElementById('customTheme');

    themeSelect.addEventListener('change', () => {
        if (themeSelect.value === 'Inna') {
            customDiv.style.display = 'block';
        } else {
            customDiv.style.display = 'none';
        }
    });
</script>

